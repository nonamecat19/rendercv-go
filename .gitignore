# Build output
/bin/
/dist/
# The binary when built in place; not cmd/rendercv-go/, which is source.
/rendercv-go

# Go
*.test
*.out
/coverage.out

# Local scratch
/tmp/
/rendercv_output/
*.local.*

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# The project's agents and skills are part of the deliverable, so they must be
# tracked even though a global gitignore excludes .claude/.
!.claude/
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/settings.json
.claude/settings.local.json

# Golden regeneration workspace (goldens themselves ARE committed)
/testdata/.work/

# Python side of the conformance harness
__pycache__/
.venv/

# Stray binaries from `go build ./...`
/gengolden
