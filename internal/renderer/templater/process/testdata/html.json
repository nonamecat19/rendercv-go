[{"In": "He said \"hello\".", "Out": "<p>He said \"hello\".</p>"}, {"In": "A <b>bold</b> tag.", "Out": "<p>A <b>bold</b> tag.</p>"}, {"In": "A & an amp.", "Out": "<p>A &amp; an amp.</p>"}, {"In": "- one\n- two", "Out": "<ul>\n<li>one</li>\n<li>two</li>\n</ul>"}, {"In": "Plain text.", "Out": "<p>Plain text.</p>"}, {"In": "**bold** and *em*", "Out": "<p><strong>bold</strong> and <em>em</em></p>"}, {"In": "[link](https://x.com)", "Out": "<p><a href=\"https://x.com\">link</a></p>"}, {"In": "<div>block</div>", "Out": "<div>block</div>"}, {"In": "[a \"quoted\" link](https://x.com/?q=\"v\")", "Out": "<p><a href=\"https://x.com/?q=\" title=\"v\">a \"quoted\" link</a></p>"}, {"In": "![alt \"q\"](img.png \"title\")", "Out": "<p><img alt=\"alt &quot;q&quot;\" src=\"img.png\" title=\"title\" /></p>"}, {"In": "`code \"q\"`", "Out": "<p><code>code \"q\"</code></p>"}, {"In": "A > B and A < B", "Out": "<p>A &gt; B and A &lt; B</p>"}, {"In": "- item with \"quotes\"", "Out": "<ul>\n<li>item with \"quotes\"</li>\n</ul>"}, {"In": "# Head \"q\"", "Out": "<h1>Head \"q\"</h1>"}]
