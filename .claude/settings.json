{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(go mod:*)",
      "Bash(gofumpt:*)",
      "Bash(golangci-lint:*)",
      "Bash(just:*)",
      "Bash(cmp:*)",
      "Bash(diff:*)",
      "Bash(uv run:*)",
      "Bash(git submodule status:*)"
    ],
    "deny": [
      "Edit(third_party/**)",
      "Write(third_party/**)",
      "Bash(git push:*)"
    ]
  }
}
