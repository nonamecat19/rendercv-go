    {
      "$comment": [
        "A valid document with no `cv:` key at all. Upstream's `default_factory=Cv`",
        "(schema/models/rendercv_model.py:19-23) fills in an empty CV, so this renders at",
        "exit 0; the absent `cv.name` leaves the NAME_IN_SNAKE_CASE placeholder unsubstituted",
        "(renderer/path_resolver.py:77-79, :104-106), which is why the artifact is named",
        "NAME_IN_SNAKE_CASE_CV.typ. The port used to dereference nil here and exit 2."
      ],
      "name": "absent_cv",
      "axis": "artifacts",
      "inline_files": [
        {
          "dst": "cv.yaml",
          "content": "locale:\n  language: english\n"
        }
      ],
      "args": [
        "render",
        "cv.yaml",
        "-nopdf",
        "-nopng",
        "--settings.current_date",
        "2025-03-05"
      ]
    },
